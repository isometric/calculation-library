[build-system]
build-backend = "uv_build"
requires = ["uv_build"]

[dependency-groups]
dev = [
  "gitpython==3.2.1",
  "markdown-it-py==4.2.0",
  "molmass==2026.8.15",
  "more-itertools==11.2.1",
  "pandas-stubs==3.0.5.260914",
  "pytest==9.1.1",
  "ruff==0.17.2",
  "scipy-stubs==1.18.1.1",
  "toml-sort==0.25.0",
  "tomlkit==0.15.2",
  "typer==0.27.3",
]

[project]
dependencies = [
  "affine==3.0.1",
  "geopandas==1.2.0",
  "numpy==2.5.4",
  "pandas==3.0.6",
  "pydantic==2.14.1",
  "pyproj==3.8.0",
  "rasterio==1.5.2",
  "scikit-learn==1.9.1",
  "scipy==1.18.1",
  "shapely==2.2.0",
  "statsmodels==0.15.0",
  "xarray==2026.9.0",
]
license = "PolyForm-Noncommercial-1.0.0"
license-files = ["LICENSE"]
name = "isometric-calculation-library"
readme = "README.public.md"
requires-python = ">=3.13"
version = "0.55.0"

[tool.pyright]
extends = "../../services/backend/base_configs/pyrightconfig.json"
reportImportCycles = "error" # this makes it easier to inline hidden imports, by topologically sorting a DAG of modules

[tool.ruff]
extend = "../../services/backend/base_configs/ruff.toml"

[tool.ruff.lint]
extend-select = ["missing-copyright-notice"]

[tool.ruff.lint.flake8-tidy-imports.extend-banned-api]
"molmass".msg = "molmass is a test-only dependency. Element data is inlined in elements.py and tested against molmass."

[tool.ruff.lint.flake8-copyright]
notice-rgx = '# Copyright \(c\) 2026 Isometric HQ Ltd\n# Licensed under PolyForm Noncommercial 1\.0\.0\n# https://polyformproject\.org/licenses/noncommercial/1\.0\.0/\n'

[tool.ruff.lint.per-file-ignores]
"**/test_*.py" = ["assert"]

[tool.tomlsort]
no_sort_tables = true
sort_inline_tables = true
sort_table_keys = true
spaces_indent_inline_array = 2
trailing_comma_inline_array = true

[tool.uv]
exclude-newer = "3 days" # prevent installing packages uploaded in the last 3 days (supply chain protection)

[tool.uv.build-backend]
module-root = ""
# (1) Keep this in sync with .github/paths/calculation-library-package-scope.env
# (2) Exclude patterns are unanchored by default, so they need a leading "/" to
# match only the project root; include patterns are already root-anchored,
# so a leading "/" there breaks the match.
source-exclude = ["/isometric_calculation_library/hidden"]
source-include = ["CHANGELOG.md"]
wheel-exclude = ["/isometric_calculation_library/hidden"]
